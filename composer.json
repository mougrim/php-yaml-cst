{
    "name": "mougrim/yaml-cst",
    "description": "PHP library for parsing and manipulating YAML documents while preserving format using Tree-sitter via FFI (Concrete Syntax Tree)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "yaml",
        "parser",
        "tree-sitter",
        "cst",
        "concrete-syntax-tree",
        "ffi"
    ],
    "homepage": "https://github.com/mougrim/php-yaml-cst",
    "authors": [
        {
            "name": "Mougrim",
            "homepage": "https://github.com/mougrim"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-ffi": "*"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.1"
    },
    "autoload": {
        "psr-4": {
            "Mougrim\\YamlCst\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mougrim\\YamlCst\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
